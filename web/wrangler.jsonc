{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendpoint",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "sendpoint.app", "custom_domain": true }
  ]
}
